C MP_sc
{ [x] = 0; [y] = 0; [obs0] = 0; [obs1] = 0; }

P0 (atomic_int* x, atomic_int* y) {
  atomic_store_explicit(x, 1, memory_order_seq_cst);
  atomic_store_explicit(y, 1, memory_order_seq_cst);
}

P1 (atomic_int* x, atomic_int* y, volatile int* obs0, volatile int* obs1) {
  int r0 = atomic_load_explicit(y, memory_order_seq_cst);
  int r1 = atomic_load_explicit(x, memory_order_seq_cst);
  *obs0 = r0;
  *obs1 = r1;
}

exists (obs0=1 /\ obs1=0)
